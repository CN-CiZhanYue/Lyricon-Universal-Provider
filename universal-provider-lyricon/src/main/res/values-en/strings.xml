    <string name="settings_network_title">Allow network lyric fetching</string>
    <string name="settings_network_desc">When off, the app will not access the network and will only use the cache shared with the official version; lyrics may be unavailable if the official version is not installed.</string>
    <string name="network_warning_title">Upstream version not detected</string>
    <string name="network_warning_message">With network access off, only the cache shared with the upstream version can be used, and lyrics may be unavailable. Turn it off anyway?</string>
    <string name="network_warning_confirm">Turn off anyway</string>
    <string name="network_warning_cancel">Cancel</string>
    <string name="about_network_hint">Network switch</string>
    <string name="about_network_body">Toggle it in Settings → Allow network lyric fetching. It is on by default; when off, only the cache shared with the official version is used.</string>
